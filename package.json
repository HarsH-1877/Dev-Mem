{
  "name": "dev-mem",
  "version": "0.1.0",
  "description": "Shared, verified development state for AI coding agents — preserves decisions, failed approaches, and discoveries across sessions and agent switches",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dev-mem": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./graph": "./dist/core/graph/index.js",
    "./capture": "./dist/core/capture/index.js",
    "./lifecycle": "./dist/core/lifecycle/index.js",
    "./extraction": "./dist/core/extraction/index.js",
    "./retrieval": "./dist/core/retrieval/index.js",
    "./regression": "./dist/core/regression/index.js",
    "./consistency": "./dist/core/consistency/index.js"
  },
  "files": [
    "dist/cli",
    "dist/core",
    "dist/adapters",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "memory",
    "knowledge-graph",
    "development-state",
    "context",
    "hooks"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HarsH-1877/Dev-Mem"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npm run build && node dist/eval/run-eval.js",
    "eval:cross-agent": "npm run build && node dist/eval/harness/cross-agent.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
